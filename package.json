{
  "name": "panel-sim",
  "version": "0.6.0",
  "private": true,
  "description": "Windows desktop industrial electrical panel simulator — clean-room rebuild",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "electron:build-main": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=electron/main.cjs",
    "electron": "npm run electron:build-main && electron .",
    "package:win": "npm run build && npm run electron:build-main && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.panelsim.desktop",
    "productName": "PanelSim",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "panel-sim"
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "electron": "*"
  }
}
