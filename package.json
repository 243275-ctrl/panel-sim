{
  "name": "panel-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop industrial electrical panel simulator — clean-room rebuild",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "electron:build-main": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=electron/main.cjs",
    "electron": "npm run electron:build-main && electron ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "electron": "*"
  }
}
